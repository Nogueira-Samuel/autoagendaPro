# ================================================
# AutoAgenda Pro - Backend Configuration
# ================================================

# Database Configuration
DATABASE_URL=postgresql://autoagenda_user:your_password@localhost:5432/autoagenda

# Security
SECRET_KEY=generate-a-secret-key-min-32-characters-use-secrets.token_urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - Frontend URLs (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Evolution API (WhatsApp Integration)
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your-evolution-api-key

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Notification System Settings
NOTIFICATION_REMINDER_24H=true     # Send 24h reminders
NOTIFICATION_REMINDER_1H=true      # Send 1h reminders
NOTIFICATION_CONFIRMATION=true     # Send confirmation on booking
NOTIFICATION_THANKS=true           # Send thanks after appointment

# ================================================
# How to generate SECRET_KEY:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ================================================
